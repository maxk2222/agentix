# --- Minimal environment template for Agentix ---
# Copy this file to `.env` and fill in the required values.
# All variables here are either required or security-recommended.
# Everything else falls back to sensible defaults defined in agent/config.py.

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=agentix

# --- Core LLM / Embeddings ---
# Base URL of an OpenAI-compatible server (WITHOUT trailing /v1) 
# You can always add LLM Providers later via the dashboard.
LLM_API_URL=http://localhost:11434
# (optional) API key for the upstream chat/completions endpoint
LLM_API_KEY=
# (optional) Base URL for embeddings if different from LLM_API_URL.
# Can be set in Dashboard later if needed, so not required here.
EMBEDDINGS_API_URL=

# --- Vector Store / Postgres ---
# Postgres connection settings. Required if using the default PGVector store.
PGHOST=localhost
PGPORT=5432
PGDATABASE=agentix-db
PGUSER=agentix-user
PGPASSWORD=<your_password_here>

# --- Service Security ---
# (optional) API key for this service. Leave empty to disable auth. You can always add API keys later via the dashboard.
API_KEY=

# --- Dashboard / Admin ---
DASHBOARD_ENABLED=true
# (optional) Admin login password. Required only when DASHBOARD_ENABLED=true.
DASHBOARD_ADMIN_PASSWORD=<your_password_here>
# (optional) Secret for signing session cookies. Required only when DASHBOARD_ENABLED=true.
DASHBOARD_SESSION_SECRET=<your_secret_here>

# --- WebDAV external sources ---
# 32-byte hex key for AES-GCM encryption of WebDAV passwords stored in DB.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBDAV_ENCRYPTION_KEY=<your_32_byte_hex_key_here>

# --- Database backup ---
# REQUIRED for backups: archive encryption key (32 bytes hex or base64).
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=<your_backup_key_here>


