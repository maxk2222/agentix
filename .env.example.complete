# --- Set project/stack name for Docker Compose for CI/CD Deployment ---
COMPOSE_PROJECT_NAME=agentix

# --- Core RAG / LLM configuration ---
# Base URL of an OpenAI-compatible server (WITHOUT trailing /v1)
LLM_API_URL=http://localhost:11434
# (optional) API key for the upstream OpenAI-compatible chat/completions endpoint.
LLM_API_KEY=
SYSTEM_SLOW=true
AUTO_INITIALIZE=true
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false    # Disable in production (use Dashboard /config/apply for hot-reload)
API_SERVER=granian     # HTTP server: "granian" (default, Rust-backed) or "uvicorn"
# (optional) API key for this service. Leave empty to disable authentication.
API_KEY=

# --- Knowledge base inputs ---
DATA_DIR=./data
INSTRUCTIONS_FILE=./data/SystemInstructions/instructions.yaml
# (optional) Comma-separated list of URLs that will be scraped alongside DATA_DIR contents
KNOWLEDGE_URLS=

# --- Embeddings configuration ---
EMBEDDING_MODEL=nomic-embed-text
# (optional) Base URL for embeddings (WITHOUT trailing /v1). If unset, the service reuses LLM_API_URL.
EMBEDDINGS_API_URL=http://localhost:11434
# (optional) Override for non-OpenAI endpoints (e.g. Ollama legacy route). If unset, the
# service calls `${EMBEDDINGS_API_URL}/v1/embeddings` and automatically falls back to
# `/api/embeddings` on HTTP 404.
EMBEDDINGS_ENDPOINT=
# (optional) API key for the embeddings endpoint.
EMBEDDINGS_API_KEY=

# Embeddings request tuning
EMBEDDINGS_REQUEST_TIMEOUT=30
EMBEDDINGS_MAX_RETRIES=3
EMBEDDINGS_BACKOFF_FACTOR=0.5
# Fallback safety net: truncate texts to this many characters before embedding.
# Should be comfortably larger than CHUNK_SIZE. Set to 0 to disable.
EMBEDDING_MAX_CHARS=4000

# --- Vector store / Postgres (PGVector) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=agentix-db
PGUSER=agentix-user
PGPASSWORD=<your_password_here>   # Fill in your Postgres password here

# --- Redis (optional: run-registry fanout, steering, leader locks, cache) ---
# Unset/empty → all features stay in-process (single-node deployments).
# The bundled compose redis enforces --requirepass — REDIS_PASSWORD is
# generated automatically by scripts/setup.sh.
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

VECTOR_SEARCH_K=5
VECTOR_BATCH_SIZE=200
VECTOR_FORCE_REBUILD=false       # Force rebuilding vectors on startup

# Incremental indexing (recommended when docs rarely change)
INDEXING_INCREMENTAL_ENABLED=true

# --- Chunking / Loader tuning ---
CHUNK_SIZE=750
CHUNK_OVERLAP=100
LOADER_MAX_CONCURRENCY=8

# --- Hybrid retrieval (PGVector + Postgres FTS + pg_trgm) ---
# Requires the DB user to be able to create the `pg_trgm` extension and the indexes
# (the app will warn + continue if not).
RETRIEVAL_HYBRID_ENABLED=true
HYBRID_VECTOR_CANDIDATES=40
HYBRID_KEYWORD_CANDIDATES=40
HYBRID_RRF_K=60
HYBRID_MAX_CHUNKS_PER_SOURCE=3
HYBRID_QUERY_EXPANSION_ENABLED=true
HYBRID_MAX_EXPANDED_QUERIES=2

# Minimum cosine similarity for a chunk to be included in RAG context.
# 0.0 disables the filter. A value like 0.45-0.55 can improve precision.
HYBRID_MIN_SEMANTIC_SIMILARITY=0.0

# --- Lightweight history-aware retrieval (no LLM call) ---
# When enabled the retriever receives a query built from recent user messages.
RETRIEVAL_HISTORY_ENABLED=true
RETRIEVAL_HISTORY_USER_MESSAGES=2
RETRIEVAL_HISTORY_MAX_CHARS=800
# Detect standalone definition/explanation queries and skip history mixing.
RETRIEVAL_HISTORY_STANDALONE_DETECTION=true

# --- Recency-weighted retrieval ---
# Run a primary search on the latest user message and only backfill with the
# history-mixed query, so fresh intent dominates retrieved documents.
RETRIEVAL_RECENCY_ENABLED=true
# Share of result slots reserved for latest-message hits (0.0-1.0).
RETRIEVAL_RECENCY_PRIMARY_SHARE=0.6

# --- Question contextualization (history-aware retrieval via extra LLM call) ---
# LangChain's history-aware retriever does an extra LLM call to rewrite the user question.
# This improves follow-up questions but can add significant latency.
CONTEXTUALIZE_QUESTION_ENABLED=false
# (optional) Model override for contextualization (e.g. a smaller/faster model)
CONTEXTUALIZE_QUESTION_MODEL=
CONTEXTUALIZE_QUESTION_TEMPERATURE=0.0
# Disable reasoning for rewrite step (usually faster)
CONTEXTUALIZE_QUESTION_DISABLE_REASONING=true

# --- Model-aware reasoning parameter rules (optional) ---
# Extend/override the built-in reasoning parameter families without a redeploy.
# Accepts a JSON array/object of rules or a path to a JSON file with the same
# structure. Rules are prepended to the built-in table (first match wins).
# wire formats: qwen_thinking, chat_template_thinking,
#   chat_template_enable_thinking, claude_thinking, gemini_thinking,
#   openai_effort, generic
# REASONING_PARAM_RULES_JSON=[{"family":"custom","patterns":["mymodel"],"wire":"openai_effort","controls":[{"key":"effort","type":"select","options":["low","high"]}]}]

# --- Retriever invocation timeout ---
# Timeout (seconds) for per-collection async retriever calls.
RETRIEVER_TIMEOUT_SECONDS=10.0

# --- Rolling history (token-budget summarization) ---
# Maximum number of prior messages (excluding the latest user message) forwarded to the LLM.
# Set to 0 to disable truncation.
MAX_HISTORY_MESSAGES=50
ROLLING_HISTORY_ENABLED=true
ROLLING_HISTORY_CONTEXT_WINDOW=32768
ROLLING_HISTORY_MAX_OUTPUT_TOKENS=2048
ROLLING_HISTORY_RAG_RESERVED_TOKENS=0
ROLLING_HISTORY_MIN_RECENT_TURNS=4
ROLLING_HISTORY_SAFETY_MARGIN_RATIO=0.08
ROLLING_HISTORY_SUMMARY_TIMEOUT_SECONDS=30.0

# --- Streaming ---
# Seconds without any stream activity (token, reasoning, tool or subagent event)
# before a run is aborted. No fixed total-run limit — working runs continue.
# Legacy name STREAMING_TIMEOUT_SECONDS is still accepted as a fallback.
STREAM_IDLE_TIMEOUT_SECONDS=300

# --- Input validation (user message / request payload) ---
# Hard cap for incoming JSON bodies (bytes). Set 0 to disable (not recommended).
MAX_REQUEST_BYTES=1048576
# Message-level limits for /v1/chat/completions
MAX_MESSAGES=100
MAX_MESSAGE_CHARS=20000
MAX_TOTAL_CHARS=120000
# Require last message to be from the user
REQUIRE_LAST_USER=true
# Reject non-string message content (lists/dicts/tool blocks)
ALLOW_NON_STRING_CONTENT=false
# Control character policy: allow|reject
VALIDATION_CONTROL_CHARS_MODE=reject
# When false, logs validation issues but does not block
VALIDATION_ENFORCE=true

# --- Chat uploads ---
# Image upload: sent to the model as multimodal content (requires a
# vision-capable model). Used by the dashboard chat and public chat.
CHAT_IMAGE_UPLOAD_ENABLED=false
CHAT_IMAGE_MAX_SIZE_BYTES=5242880
CHAT_IMAGE_MAX_COUNT=4
CHAT_IMAGE_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif
# Document upload: text is extracted server-side and injected into every
# turn as <attachment> context blocks for that conversation. Raw files are
# stored under data/chat_uploads/<conversation_id>/ and never served back.
CHAT_FILE_UPLOAD_ENABLED=false
CHAT_FILE_ALLOWED_EXTS=.docx,.xlsx,.pptx,.pdf,.odt,.csv,.txt,.md,.doc,.xls,.ppt,.png,.jpg,.jpeg,.webp,.gif,.bmp,.tiff
CHAT_FILE_MAX_SIZE_BYTES=52428800
CHAT_FILE_MAX_COUNT=5
# Per-file extraction cap and total injection budget (chars)
CHAT_FILE_MAX_EXTRACT_CHARS=50000
CHAT_FILE_MAX_TOTAL_CHARS=120000
# Hard timeout for a single file's extraction (seconds)
CHAT_FILE_EXTRACT_TIMEOUT_SECONDS=120
# Legacy office formats (.doc/.xls/.ppt) additionally require LibreOffice
# (see LIBREOFFICE_PATH below) for conversion before extraction.

# --- OCR / Document processing ---
OCR_LANG=deu
# (optional) Absolute path to tesseract.exe (leave empty to use PATH lookup)
TESSERACT_CMD=

# --- Dashboard / Admin session settings ---
DASHBOARD_ENABLED=true
DASHBOARD_ADMIN_USERNAME=admin
# (optional) Admin login password. Leave empty to disable dashboard login.
DASHBOARD_ADMIN_PASSWORD=
# (optional) Secret for signing session cookies. Required only when DASHBOARD_ENABLED=true.
DASHBOARD_SESSION_SECRET=
# Sliding renewal: sessions are refreshed on activity, so the TTL counts from
# the last request, not from login (middleware re-issues the cookie past half TTL).
DASHBOARD_SESSION_TTL_SECONDS=3600

# --- WebDAV external sources ---
# 32-byte hex key for AES-GCM encryption of WebDAV passwords stored in DB.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBDAV_ENCRYPTION_KEY=

# --- Database backup (encrypted pg_dump -> WebDAV/Sciebo) ---
# REQUIRED for the backup feature: symmetric key for archive encryption
# (32 bytes, hex or base64). Backups fail closed when unset.
# Keep this key OUTSIDE the database (env/.env) - it must survive a DB loss.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# Local scratch dir for dump/encrypt (auto-cleaned, mode 0700).
#BACKUP_TMP_DIR=data/backups/tmp
# Timeout for pg_dump/pg_restore subprocesses (seconds).
#BACKUP_DUMP_TIMEOUT=1800
# WebDAV upload/download timeout (seconds).
#BACKUP_UPLOAD_TIMEOUT=600
# Upload retry attempts with exponential backoff.
#BACKUP_UPLOAD_RETRIES=3
# Instance name embedded in backup filenames (defaults to hostname).
#BACKUP_INSTANCE=

# --- Widget defaults (public endpoint consumed by embedded widgets) ---
# Comma-separated origins allowed to fetch GET /widget-defaults cross-origin.
# Use "*" to allow any website to embed the widget (default). For a stricter
# setup, list the exact origins, e.g. "https://site-a.com,https://site-b.com".
#WIDGET_DEFAULTS_CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO      # Set to DEBUG for verbose logging (not recommended in production)
LOG_DIR=logs
LOG_FILE_MAX_BYTES=5242880

# --- Emotion Detection (optional) ---
# Enable multimodal emotion detection (text, webcam, audio)
EMOTION_DETECTION_ENABLED=false
EMOTION_WEBCAM_ENABLED=false
EMOTION_AUDIO_ENABLED=false
# (optional) Download URLs for ONNX models; auto-downloaded on startup if set and missing
EMOTION_WEBCAM_FACE_MODEL_DOWNLOAD_URL=
EMOTION_WEBCAM_EXPRESSION_MODEL_DOWNLOAD_URL=
EMOTION_AUDIO_MODEL_DOWNLOAD_URL=
# --- Document artifacts (document_generator tool) ---
# Path to a LibreOffice binary for artifact previews/exports (auto-detected
# from PATH or /Applications/LibreOffice.app when unset).
#LIBREOFFICE_PATH=
# Path to the graphviz 'dot' binary for nicer diagram layouts (optional).
#GRAPHVIZ_PATH=

# --- MCP tool servers (external tools via Model Context Protocol) ---
# MCP servers are configured in the dashboard under Tools → mcp_servers
# (config JSON "servers" list) — not via env. Each server entry:
#   {"name":"gws","transport":"stdio","command":"uvx",
#    "args":["workspace-mcp","--tools","drive","calendar","docs"],
#    "env":{"GOOGLE_OAUTH_CLIENT_ID":"…","GOOGLE_OAUTH_CLIENT_SECRET":"…"},
#    "enabled":true,"tool_filter":["*drive*","*calendar*"]}
# or streamable-HTTP sidecar:
#   {"name":"gws","transport":"http","url":"http://workspace-mcp:8000/mcp",
#    "headers":{"Authorization":"Bearer …"},"enabled":true}
# Discovered tools appear as 'mcp__<server>__<tool>' entries in Tools and are
# assigned to assistants like any other tool. Changes apply on save (no restart).
# For 'stdio' transport the 'uvx'/'uv' binary (pip install uv) or the server
# binary itself must be reachable from the backend environment.

# --- Chat file lifecycle (storage sweeper) ---
# Orphaned per-conversation file dirs (artifacts/, chat_uploads/) whose
# conversation has no DB record are deleted once older than this many days.
# Covers uploads to never-finished conversations and client-forgotten resets.
CHAT_FILES_ORPHAN_TTL_DAYS=7
# Optional: also delete the FILES of conversations whose record is older than
# this many days (conversation + message history are kept). 0 = keep forever.
CHAT_FILES_RETENTION_DAYS=0

# --- Code-execution sandbox (Docker) ---
# Idle-seconds before a conversation's sandbox container is destroyed (60-3600).
#SANDBOX_TTL_SECONDS=300
# Host root for per-conversation workspace dirs mounted at /workspace when the
# code_execution tool config sets sandbox_mode=writable_workspace. Default:
# <DATA_DIR>/sandbox_workspaces. Each conversation gets its OWN subdirectory —
# never point this at a shared dir.
#SANDBOX_WORKSPACE_ROOT=
# Explicit sandbox image tag override (default: agentix/sandbox:<content-hash> —
# the hash auto-rebuilds the image when sandbox_server.py changes).
#SANDBOX_IMAGE=
# NOTE for containerized deployments (app talks to docker.sock): the bind
# source is resolved by the DOCKER DAEMON on the host — SANDBOX_WORKSPACE_ROOT
# must be an absolute HOST path, while the app reaches the same dir via
# SANDBOX_WORKSPACE_APP_ROOT (its own mount path, e.g. /app/data/...).
#SANDBOX_WORKSPACE_APP_ROOT=
# "1" forces every sandbox's egress policy to internet=off (hard operator
# floor — a sidecar iptables chain additionally kills the embedded-DNS
# resolver so DNS-tunnel exfiltration fails too; newly created bridges are
# internal for defense in depth). pip installs inside the sandbox then
# fail. Finer-grained control (internet / local-network toggles, blocked
# CIDRs) lives in the code_execution tool config; this env always wins.
#SANDBOX_NETWORK_INTERNAL=
# Comma-separated IPs/CIDRs dropped for EVERY sandbox, unioned with the
# tool's egress_blocked list — e.g. org-internal ranges that must stay
# unreachable even when an admin enables LAN access.
#SANDBOX_EGRESS_BLOCKED_CIDRS=
# Container runtime override for stronger kernel isolation — e.g. "runsc"
# (gVisor) or a Kata runtime when installed on the host.
#SANDBOX_RUNTIME=
# pip mirror / hardening for sandbox package installs. PIP_INDEX_URL points
# pip at an internal devpi/Nexus mirror (e.g. an allowlisted package set);
# ONLY_BINARY=1 forbids sdist builds so no setup.py code ever executes.
# The values reach only the pip subprocess env — never generated code.
#SANDBOX_PIP_INDEX_URL=
#SANDBOX_PIP_EXTRA_INDEX_URL=
#SANDBOX_PIP_ONLY_BINARY=
# RLIMIT_NOFILE / RLIMIT_FSIZE (MB) inside the sandbox — generated code
# otherwise inherits unlimited values.
#SANDBOX_NOFILE_LIMIT=4096
#SANDBOX_FSIZE_LIMIT_MB=2048
# Persistent per-assistant agent workspaces (workspace.enabled in the
# assistant config). Mounted into sandboxes at /agent_ws. Same
# daemon-vs-app split as above: AGENT_WORKSPACE_ROOT is the daemon-visible
# bind source, AGENT_WORKSPACE_APP_ROOT the path the app itself uses.
# Defaults to <DATA_DIR>/agent_workspaces. When the app runs containerized
# and ROOT is unset, the host path is auto-derived from
# /proc/self/mountinfo (works for the ./data:/app/data compose layout);
# set it explicitly for non-standard mount layouts or remote dockerd —
# a WRONG value mounts an arbitrary host directory into the sandbox.
#AGENT_WORKSPACE_ROOT=
#AGENT_WORKSPACE_APP_ROOT=
# Disk cache for workspace document rendering (workspace.vision_read 'view'):
# rendered page PNGs and LibreOffice-converted PDFs. LRU-evicted at 256 MB,
# entries expire after 24 h. Default: ws_render_cache next to the workspaces root.
#AGENT_WORKSPACE_RENDER_CACHE=
